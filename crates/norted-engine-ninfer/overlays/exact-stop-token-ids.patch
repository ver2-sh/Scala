 void parse_stop(const Json& body, GenerationRequest& output) {
+    if (body.contains("stop_token_ids")) {
+        const auto& ids = body.at("stop_token_ids");
+        if (!ids.is_array() || ids.empty()) { bad_request("expected a non-empty token ID array", "stop_token_ids"); }
+        for (const auto& id : ids) {
+            if (!id.is_number_integer() || id.get<int64_t>() < 0 || id.get<uint64_t>() > 2147483647ULL) {
+                bad_request("invalid token ID", "stop_token_ids");
+            }
+            const int token = id.get<int>();
+            if (std::find(output.stop_token_ids.begin(), output.stop_token_ids.end(), token) != output.stop_token_ids.end()) {
+                bad_request("duplicate token ID", "stop_token_ids");
+            }
+            output.stop_token_ids.push_back(token);
+        }
+    }
+
     if (!body.contains("stop") || body.at("stop").is_null()) { return; }
     output.stop_strings_apply_to_reasoning = true;
     const Json& stop                       = body.at("stop");
